# Copy to java-regression-runner/runner.env for local runs
# or point JR_ENV_FILE to a file on your Linux host.

JR_THREADS=3
JR_PARTIAL_REPORT_INTERVAL_SECONDS=300
JR_CONNECT_TIMEOUT_MS=60000
JR_READ_TIMEOUT_MS=900000
JR_FAIL_ON_TEST_FAILURES=false
JR_RESPONSE_CHAINING_ENABLED=true
# Optional override. By default, the local launcher shares
# ../regression-runner.lock so runs cannot overlap against the same API
# environment at the same time.
# JR_RUN_LOCK=/absolute/path/to/regression-runner.lock
# Must point to a Java 17+ runtime when running the fat JAR locally.
# Leave as "java" only if your PATH java is Java 17+.
JR_JAVA_BIN=java

JR_PROTOCOL=https
JR_SERVER=api.example.com
JR_TENANT=testground
JR_USERNAME=operator
JR_PASSWORD=replace-me
JR_TOKEN_PATH=/identity/v1/token

# Optional local-development override when identity runs on a different base URL.
# Example:
# JR_TOKEN_URL=http://localhost:2021/identity/v1/token
JR_TOKEN_URL=

# Optional per-service local routing. Format:
# JR_SERVICE_BASE_URLS=portfolio=http://localhost:5200,feeamortization=http://localhost:5300,customer=http://localhost:5400,office=http://localhost:5500,clientservice=http://localhost:5600,notifications=http://localhost:5700,accounting=http://localhost:5800
#
# Leave blank in shared dev environments where all services are reachable through JR_SERVER.
JR_SERVICE_BASE_URLS=

JR_DB_URL=jdbc:mysql://replace-me:3306
JR_DB_USERNAME=replace-me
JR_DB_PASSWORD=replace-me
JR_DB_DRIVER=com.mysql.cj.jdbc.Driver
JR_DB_CONNECT_TIMEOUT_SECONDS=30
JR_DB_QUERY_TIMEOUT_SECONDS=120
